# ─────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill it in.
#  .env.local is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION. Signs session cookies and hashes one-time
# codes. Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Your real origin, no trailing slash. Used for canonical URLs,
# Open Graph and the sitemap.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Leave unset until the store is real. While this is not "true"
# every page ships noindex,nofollow — which is what you want for a
# staging build.
NEXT_PUBLIC_ALLOW_INDEXING=

# ── Payments (Razorpay) ──────────────────────────────────────
# Without these, checkout stops honestly at the payment step and
# says online payment is not configured. Cash on delivery still
# works. Nothing anywhere fakes a successful payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend, or swap the adapter in src/lib/mail.ts) ───
# Without this, a sign-in code is written to the server log instead
# of being emailed, and the UI says so.
RESEND_API_KEY=
MAIL_FROM="ROOH <orders@yourdomain.com>"

# ── Database ─────────────────────────────────────────────────
# Unset means the JSON file store in ./data, which is for local
# development only. See SETUP.md before going live.
DATABASE_URL=
